{
  "name": "codeigniter-cms-tests",
  "version": "1.0.0",
  "description": "Playwright tests for CodeIgniter CMS with SCSS build pipeline",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:chrome": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:mobile": "npx playwright test --project='Mobile Chrome'",
    "test:smoke": "npx playwright test --grep '@smoke'",
    "test:critical": "npx playwright test --grep '@critical'",
    "test:regression": "npx playwright test --grep '@regression'",
    "test:console": "npx playwright test tests/examples/console-detection.spec.js",
    "test:console-headed": "npx playwright test tests/examples/console-detection.spec.js --headed",
    "test:console-debug": "npx playwright test tests/examples/console-detection.spec.js --debug",
    "test:report": "npx playwright test --reporter=html",
    "test:update-snapshots": "npx playwright test --update-snapshots",
    "show:report": "npx playwright show-report docs/reports/playwright",
    "install:browsers": "npx playwright install",
    "clean:reports": "if exist docs\\\\reports rmdir /s /q docs\\\\reports && mkdir docs\\\\reports\\\\playwright docs\\\\reports\\\\test-results docs\\\\reports\\\\coverage docs\\\\reports\\\\screenshots docs\\\\reports\\\\videos",
    "reports:open": "start docs/reports/playwright/index.html",
    "browser:start": "npx @agentdeskai/browser-tools-mcp",
    "browser:debug": "BROWSER_TOOLS_DEBUG=true npx @agentdeskai/browser-tools-mcp",
    "browser:headless": "BROWSER_TOOLS_HEADLESS=true npx @agentdeskai/browser-tools-mcp",
    "browser:monitor": "npx @agentdeskai/browser-tools-mcp --monitor",
    "browser:capture": "npx @agentdeskai/browser-tools-mcp --capture-screenshots",
    "scss:build": "sass assets/scss:assets/css --style=compressed --source-map",
    "scss:watch": "sass assets/scss:assets/css --style=expanded --source-map --watch",
    "scss:dev": "sass assets/scss:assets/css --style=expanded --source-map",
    "css:autoprefixer": "postcss assets/css/*.css --use autoprefixer --map --replace",
    "build:css": "npm run scss:build && npm run css:autoprefixer",
    "dev:css": "npm run scss:dev && npm run css:autoprefixer",
    "watch:css": "npm run scss:watch",
    "setup:scss": "if not exist assets\\\\scss mkdir assets\\\\scss\\\\components assets\\\\scss\\\\modules assets\\\\scss\\\\layouts assets\\\\scss\\\\utils"
  },
  "keywords": ["codeigniter", "cms", "testing", "playwright", "scss", "build-pipeline"],
  "author": "QMS Development Team",
  "license": "ISC",
  "devDependencies": {
    "@agentdeskai/browser-tools-mcp": "^1.2.1",
    "@playwright/test": "^1.45.0",
    "npm": "^10.8.1",
    "sass": "^1.69.5",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.16",
    "npm-run-all": "^4.1.5",
    "chokidar-cli": "^3.0.0"
  }
}
