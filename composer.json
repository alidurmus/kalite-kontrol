{
    "name": "qms/kalite-yonetim-sistemi",
    "description": "Kalite Yönetim Sistemi - Quality Management System with CodeIgniter 3 HMVC",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "QMS Development Team",
            "email": "dev@qms.local"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.3.0",
        "phpoffice/phpspreadsheet": "^1.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpmd/phpmd": "^2.13",
        "sebastian/phpcpd": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "QMS\\": "application/",
            "QMS\\Tests\\": "tests/"
        },
        "files": [
            "application/helpers/security_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "QMS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html build/coverage",
        "test:unit": "vendor/bin/phpunit --testsuite=unit",
        "test:integration": "vendor/bin/phpunit --testsuite=integration",
        "style:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "style:fix": "vendor/bin/php-cs-fixer fix",
        "analyze": "vendor/bin/phpstan analyse -c phpstan.neon",
        "analyze:baseline": "vendor/bin/phpstan analyse -c phpstan.neon --generate-baseline",
        "sniff": "vendor/bin/phpcs --standard=PSR12 application/",
        "sniff:fix": "vendor/bin/phpcbf --standard=PSR12 application/",
        "mess": "vendor/bin/phpmd application/ text cleancode,codesize,controversial,design,naming,unusedcode",
        "cpd": "vendor/bin/phpcpd application/",
        "security:check": "composer audit",
        "quality": [
            "@style:check",
            "@analyze",
            "@sniff",
            "@mess",
            "@cpd"
        ],
        "audit": [
            "@style:check",
            "@analyze", 
            "@test",
            "@security:check"
        ],
        "ci": [
            "@quality",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "test": "Run all PHPUnit tests",
        "test:coverage": "Run tests with coverage report",
        "style:check": "Check code style compliance (PSR-12)",
        "style:fix": "Fix code style issues automatically",
        "analyze": "Run static analysis with PHPStan",
        "quality": "Run all quality checks",
        "audit": "Run security and quality audit",
        "ci": "Run complete CI pipeline"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.1.x-dev"
        }
    }
} 