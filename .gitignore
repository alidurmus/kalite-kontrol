# QMS Projesi .gitignore

# Test Reports (sakla: README.md)
docs/reports/*
!docs/reports/README.md

# Eski test sonuçları
test-results/
playwright-report/

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.npm/

# Environment files
.env
.env.local
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Application cache
application/cache/sessions/*
!application/cache/sessions/index.html
application/cache/*.dat
application/cache/mask_*

# Uploads (geçici)
uploads/temp/
uploads/cache/

# Vendor dependencies
vendor/
composer.lock

# Backup files
*.bak
*.backup
*.old 